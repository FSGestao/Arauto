# Copie para .env.local e ajuste.

# Segredo dos tokens JWT. Se não definido, é gerado automaticamente e
# persistido em data/secret.key no primeiro uso.
JWT_SECRET=

# Conta super-admin criada automaticamente no primeiro acesso, se ainda não
# existir nenhuma conta com esse papel.
SUPERADMIN_EMAIL=admin@suaigreja.com
SUPERADMIN_PASSWORD=mude-esta-senha

# Para onde as notificações de novas solicitações são enviadas (opcional)
ADMIN_NOTIFY_EMAIL=admin@suaigreja.com

# SMTP (opcional — sem isso, os e‑mails só são exibidos no log do servidor)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
