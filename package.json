{
  "name": "arauto-app",
  "version": "1.5.0",
  "description": "Sistema de projeção para igrejas — letras, avisos, mídia, Bíblia e roteiro de culto em um só painel.",
  "author": "FSGestao",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "node scripts/fix-7za-symlink.js",
    "dev": "cross-env NODE_ENV=development node server.js",
    "build": "next build",
    "start": "cross-env NODE_ENV=production node server.js",
    "lint": "next lint",
    "verificar": "node scripts/verificar-painel.js && node scripts/verificar-ao-vivo.js",
    "verificar:painel": "node scripts/verificar-painel.js",
    "verificar:ao-vivo": "node scripts/verificar-ao-vivo.js",
    "electron": "electron .",
    "electron:pack": "next build && electron-builder --win",
    "preelectron:publish": "node scripts/check-release-notes.js",
    "electron:publish": "next build && electron-builder --win --publish always"
  },
  "dependencies": {
    "archiver": "^5.3.2",
    "bcryptjs": "^2.4.3",
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "fast-xml-parser": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "youtube-captions-scraper": "^2.0.1"
  },
  "devDependencies": {
    "@types/archiver": "^5.3.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "cross-env": "^7.0.3",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "typescript": "^5.6.2"
  },
  "build": {
    "appId": "com.arauto.app",
    "productName": "Arauto",
    "asar": false,
    "files": [
      "server.js",
      "lib/**/*",
      "electron/**/*",
      ".next/**/*",
      "public/**/*",
      "seed/**/*",
      "release-notes/**/*",
      "next.config.js",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "Arauto-Setup.${ext}"
    },
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "FSGestao",
      "repo": "Arauto"
    }
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
