# Variáveis de ambiente — copie para .env.local e ajuste se necessário.
# Nenhuma delas é obrigatória: se JWT_SECRET não for definido, o app gera e
# guarda um segredo automaticamente em data/secret.key no primeiro uso.

# Segredo para assinar os tokens de login local
JWT_SECRET=

# Porta do servidor local (admin + projeção + WebSocket)
PORT=3210
