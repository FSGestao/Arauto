# Normaliza fim de linha: o repositório guarda LF, o Windows checa out CRLF.
# Sem isso, um checkout em Linux/Mac mostraria o projeto inteiro como alterado.
* text=auto eol=lf

# Binários — nunca converter
*.png binary
*.jpg binary
*.gif binary
*.webp binary
*.mp3 binary
*.wav binary
*.mp4 binary
*.webm binary
*.ico binary
*.exe binary
